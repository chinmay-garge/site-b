{%- comment -%}
  FIXTURE — DIVERGENT COPY (site-b only).

  This is site-b's local version of a file that also exists in shopify-common.
  It differs from common in markup AND in one schema default, standing in for
  the real-world case where a site drifted from the shared theme (someone
  edited the theme directly in the Shopify admin, or the site predates the
  shared repo).

  Expected behaviour:
    1. drift-detection.yml opens an issue on site-b naming this file.
    2. shopify-common is the source of truth, so the next code deploy
       OVERWRITES this file and the marker below flips to COMMON-VERSION.

  Assert on: data-sandbox-origin="SITE-B-VERSION" disappearing after deploy.
{%- endcomment -%}

{% liquid
  assign s = section.settings
%}

<div
  class="sandbox-banner sandbox-banner--legacy"
  data-sandbox-origin="SITE-B-VERSION"
  style="padding: {{ s.padding_top }}px 20px {{ s.padding_bottom }}px; background: {{ s.background }}; border: 2px dashed #c00;"
>
  {%- if s.heading != blank -%}
    <h2 class="sandbox-banner__heading">{{ s.heading }}</h2>
  {%- endif -%}

  {%- comment -%} site-b's local copy renders the subheading ABOVE the heading. {%- endcomment -%}
  {%- if s.subheading != blank -%}
    <p class="sandbox-banner__subheading sandbox-banner__subheading--legacy">{{ s.subheading }}</p>
  {%- endif -%}

  {%- comment -%} No dismiss button here — site-b never had one. {%- endcomment -%}
</div>

{% schema %}
{
  "name": "t:sections.sandbox-banner.name",
  "tag": "section",
  "class": "sandbox-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "t:sections.sandbox-banner.settings.heading", "default": "Legacy site-b banner" },
    { "type": "text", "id": "subheading", "label": "t:sections.sandbox-banner.settings.subheading" },
    { "type": "color", "id": "background", "label": "t:sections.sandbox-banner.settings.background", "default": "#ffecec" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.sandbox-banner.settings.padding_top", "default": 16 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.sandbox-banner.settings.padding_bottom", "default": 16 }
  ],
  "presets": [{ "name": "t:sections.sandbox-banner.name" }]
}
{% endschema %}
